# Chat: Decisions seleciona memória; Responses API gera texto usando o plano ChatGPT.
CHAT_MODE=decisions
GPT_API_KEY=
# Decisions usa gpt-6-luna. OPENAI_MODEL configura somente Responses.
OPENAI_MODEL=gpt-6-luna
# Conecte a conta ChatGPT pela página Configurações da interface local.
# Credenciais OAuth ficam protegidas fora do projeto; não vão no .env.

# Curador e analista de calls usam GLM; curadoria de chat usa Responses API + Decisions.
# CHAT_MODE=legacy restaura o chat GLM anterior.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Bot e transcrição (independentes do chat).
DISCORDBOT_API_KEY=
GROQ_API_KEY=
DISCORDBOT_AUTO_TRANSCRIBE=true
DISCORDBOT_AUTO_ANALYZE=false

# Voz contínua (branch codex/gpt-live). Usa a mesma GPT_API_KEY acima.
GPT_LIVE_VOICE=marin
GPT_LIVE_IDLE_SECONDS=90
GPT_LIVE_MAX_SECONDS=1800
