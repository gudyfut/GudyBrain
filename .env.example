# Copie para `.env` na raiz do repositório e preencha com suas chaves.
# O `.env` é pessoal, fica fora do controle de versão (.gitignore).

# --- Obrigatórias para o assistente ---

# Chave da API da z.ai (GLM). https://z.ai
GLM_API_KEY=

# --- Opcionais ---

# Modelo usado pelo agente conversante (o chat). Se omitido, usa o padrão do
# registro por agente em src/agents/registry.ts.
GLM_MODEL=

# Endpoint alternativo da z.ai (o padrão é https://api.z.ai/api/paas/v4).
# Exemplo do Coding Plan: https://api.z.ai/api/coding/paas/v4
GLM_BASE_URL=

# Primeiro nome exibido na saudação da interface web.
USUARIO_NOME=

# Quantos níveis de pastas do bundle de memória são injetados no prompt (padrão 4).
MEMORIA_ARVORE_NIVEIS=

# --- Discord bot (discordbot/) ---

# Token do bot do Discord (https://discord.com/developers/applications)
DISCORDBOT_API_KEY=

# Chave da API da Groq para transcrição (https://console.groq.com)
GROQ_API_KEY=

# Transcrever automaticamente após !parar (padrão true).
DISCORDBOT_AUTO_TRANSCRIBE=true

# Analisar automaticamente após transcrever (padrão false; exige transcrição automática).
DISCORDBOT_AUTO_ANALYZE=false
