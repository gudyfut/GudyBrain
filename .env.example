# Chat: Jev seleciona memória; Responses API gera texto usando o plano ChatGPT.
CHAT_MODE=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
OPENAI_MODEL=gpt-6-luna
# Conecte a conta ChatGPT pela página Configurações da interface local.
# Credenciais OAuth ficam protegidas fora do projeto; não vão no .env.

# Curador e analista de calls usam GLM; curadoria de chat usa Responses API + Jev.
# CHAT_MODE=legacy restaura o chat GLM anterior.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Bot e transcrição (independentes do chat).
DISCORDBOT_API_KEY=
GROQ_API_KEY=
DISCORDBOT_AUTO_TRANSCRIBE=true
DISCORDBOT_AUTO_ANALYZE=false

# Google AI Studio
GEMINI_API_KEY=
